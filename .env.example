# Supabase 대시보드 > Project Settings > API 에서 복사합니다.
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 git에 올리지 않습니다.
#
# 주의: VITE_ 로 시작하는 값은 빌드 결과물에 그대로 포함되어 누구나 볼 수 있습니다.
#       anon(공개) 키만 넣으세요. service_role 키는 절대 넣지 마세요.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=여기에_anon_public_키

# 가입 가능한 이메일 도메인 (쉼표로 구분).
# 사용자에게 안내 문구를 보여주기 위한 값일 뿐이며,
# 실제 차단은 Supabase DB 트리거(allowed_email_domains)가 담당합니다.
VITE_ALLOWED_EMAIL_DOMAINS=samil-demo.example.com
